FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends bluez dbus \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-standalone.txt ./
RUN pip install --no-cache-dir -r requirements-standalone.txt

COPY custom_components/opengopro/client.py custom_components/opengopro/client.py
COPY custom_components/opengopro/frontend/opengopro-console.js custom_components/opengopro/frontend/opengopro-console.js
COPY standalone standalone

EXPOSE 8765
VOLUME ["/data"]

CMD ["python", "standalone/server.py", "--data", "/data/cameras.json"]
